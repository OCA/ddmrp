<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ddmrp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="DDMRP" string="DDMRP" name="ddmrp" groups="ddmrp.group_ddmrp_manager">
                    <block title="Extensions" name="ddmrp_extensions">
                        <setting
                            id="ddmrp_module_ddmrp_history"
                            string="DDMRP History"
                            help="Store historical data from stock buffers."
                        >
                            <field name="module_ddmrp_history"/>
                        </setting>
                        <setting
                            id="ddmrp_module_ddmrp_adjustment"
                            string="DDMRP Adjustments"
                            help="Apply adjustments to dynamically alter stock buffers to respond to planned or anticipated events."
                        >
                            <field name="module_ddmrp_adjustment"/>
                        </setting>
                        <setting
                            id="ddmrp_module_ddmrp_coverage_days"
                            string="Show Coverage Days in Stock Buffers"
                            help="Shows the current on-hand for stock buffers expressed as coverage days."
                        >
                            <field name="module_ddmrp_coverage_days"/>
                        </setting>
                        <setting
                            id="ddmrp_module_ddmrp_packaging"
                            string="Stock Buffers &amp; Packagings"
                            help="Use packagings on stock buffers."
                        >
                            <field name="module_ddmrp_packaging"/>
                        </setting>
                        <setting
                            id="ddmrp_module_stock_buffer_capacity_limit"
                            help="Set an storage capacity limit on stock buffers."
                        >
                            <field name="module_stock_buffer_capacity_limit"/>
                        </setting>
                        <setting
                            id="ddmrp_module_ddmrp_chatter"
                            help="Adds chatter and activities to stock buffers."
                        >
                            <field name="module_ddmrp_chatter"/>
                        </setting>
                        <setting
                            id="ddmrp_module_ddmrp_purchase_hide_onhand_status"
                            help="Hides on-hand status from purchase order line."
                        >
                            <field name="module_ddmrp_purchase_hide_onhand_status"/>
                        </setting>
                        <setting
                            id="ddmrp_module_ddmrp_warning"
                            help="Get configuration warnings for stock buffers."
                        >
                            <field name="module_ddmrp_warning"/>
                        </setting>
                    </block>
                    <block title="Company Settings" name="ddmrp_company_settings">
                        <setting
                            id="ddmrp_company_auto_update_nfp"
                            company_dependent="1"
                            help="Auto update Net Flow Position. Transfer status changes can trigger the update of relevant buffer's NFP."
                        >
                            <field name="ddmrp_auto_update_nfp"/>
                        </setting>
                        <setting
                            id="ddmrp_company_adu_calc_include_scrap"
                        >
                            <field name="ddmrp_adu_calc_include_scrap"/>
                        </setting>
                        <setting
                            id="ddmrp_company_qty_multiple_tolerance"
                            company_dependent="1"
                            help="Set a tolerance value to apply to quantity multiple in stock buffers.
                                    If the quantity needed is below this tolerance threshold, the recommended
                                    quantity will be reduced a bit instead of adding another bucket.
                                    The value is a percentage of the quantity multiple."
                        >
                            <field name="ddmrp_qty_multiple_tolerance"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
